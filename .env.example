# ---- Secrets de dev local UNIQUEMENT (ne jamais committer de vrais secrets) ----
POSTGRES_USER=nestora
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=userdb
POSTGRES_PORT=5432

# JWT / gateway (génère avec: openssl rand -base64 48)
JWT_SECRET=change-me-dev-only-min-32-chars-0123456789abcdef
JWT_EXPIRATION=86400000
GATEWAY_SHARED_SECRET=change-me-dev-only-gateway-secret

# Mail simulé en local
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=dummy@example.com
MAIL_PASSWORD=dummy
EMAIL_SIMULATION=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Registry GHCR (remplace par ton user)
# Faux S3 local S3Mock (sans carte) — buckets créés au démarrage
S3_BUCKET=nestora-uploads
AWS_S3_REGION=us-east-1
REGISTRY=ghcr.io
IMAGE_OWNER=marouanof
IMAGE_TAG=latest
