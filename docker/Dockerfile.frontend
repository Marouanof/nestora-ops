# syntax=docker/dockerfile:1
# frontend — Vite React 19 + Tailwind, servi par Nginx avec proxy /api -> gateway
# Contexte de build = dossier frontend de Nestora.
# Prérequis : copier ../nestora-ops/docker/nginx.conf vers ./nginx.ops.conf
# (fait par scripts/sync-dockerfiles.ps1 ou par la CI, car COPY reste dans le contexte).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine AS runtime
COPY nginx.ops.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://localhost/ || exit 1
